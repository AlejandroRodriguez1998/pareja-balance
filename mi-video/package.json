  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render ParejaBalancePromo out/pareja-balance-1080p.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-bitrate=192k --concurrency=4",
