    "music:prepare": "node scripts/prepare-music.mjs",
    "capture:serve": "node scripts/capture-server.mjs",
    "capture": "python3 scripts/capture.py",
    "verify:studio": "python3 scripts/verify-studio.py",
    "voiceover:prepare": "node scripts/prepare-voiceover.mjs",
    "render:voiceover": "remotion render ParejaBalancePromo out/pareja-balance-con-locucion.mp4 --props=docs/voiceover.props.json --codec=h264 --crf=18 --pixel-format=yuv420p --audio-bitrate=192k --concurrency=4"
